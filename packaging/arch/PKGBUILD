# Maintainer: sijin-xb <xbie96750 at gmail dot com>

pkgname=kugou-tui
pkgver=0.8.1
pkgrel=1
pkgdesc="终端里的酷狗音乐播放器（逐字歌词 / cava 频谱 / 接口内嵌）"
arch=('x86_64')
url="https://github.com/sijin-xb/kugou-tui"
license=('AGPL-3.0-or-later')
depends=('alsa-lib' 'gcc-libs' 'glibc')
makedepends=('cargo' 'cmake' 'pkgconf')
optdepends=(
	'nodejs: --api node 回退后端需要'
	'npm: 同上'
)
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

# aws-lc-sys 把 AWS-LC 的 C 代码交给 cc 编译，经不起外层 -flto（makepkg.conf 的
# LTOFLAGS 默认带 -flto=auto）。Rust 侧 Cargo.toml 已开 fat LTO，外面再叠一层
# 只是多一份风险，没有收益。见 options=('!lto')。

build() {
	cd "$pkgname-$pkgver"
	# 只用 --locked（拒绝改写 Cargo.lock），不用 --frozen：后者隐含 --offline，
	# 而 makepkg 的 --syncdeps 不预热 cargo 缓存，干净环境里必然失败。
	cargo build --release --locked
}

package() {
	cd "$pkgname-$pkgver"

	install -Dm755 target/release/kugou-tui "$pkgdir/usr/bin/kugou-tui"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
