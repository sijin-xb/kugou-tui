#!/usr/bin/env bash
#
# upload-release-asset —— 把发行包挂到 GitHub Release 上。
#
# 为什么单独写一个脚本、而不是把这几行写在 YAML 里：这件事有两个坑，两个平台都要
# 踩一遍，写进 YAML 就是复制粘贴两份（然后其中一份忘了改）。
#
# 1. **要等 Release 出现。** 本地 `scripts/release` 的顺序是「推 tag → 建 Release」，
#    而 tag 一推 CI 就起来了——直接 upload 大概率撞上 release not found。
# 2. **要幂等。** 手动重跑（`workflow_dispatch` 补资产）时资产可能已经在了，
#    要覆盖而不是报错退出。
#
# 两个平台共用同一个脚本：Windows runner 上 `shell: bash` 用的是 Git Bash，
# `gh` 与 glob 都在。这样逻辑只有一份，也能在开发机上真跑一遍。
#
# 用法：
#   ./scripts/upload-release-asset v0.4.2 'dist/*.tar.gz'
#
# 需要 `gh` 已认证。CI 里靠 `GH_TOKEN` 环境变量（workflow 的 GITHUB_TOKEN）。

set -euo pipefail

tag="${1:?用法：upload-release-asset <tag> <glob>}"
pattern="${2:?用法：upload-release-asset <tag> <glob>}"

if ! command -v gh >/dev/null 2>&1; then
  echo "找不到 gh。装一个：https://cli.github.com" >&2
  exit 1
fi

# 等 Release 出现，最多 5 分钟。
#
# 判据是 **Release 本身**而不是 tag：tag 是 CI 的触发条件，走到这一步它必然已经在；
# 真正要等的是本地那个 `gh release create`。
deadline=$((SECONDS + 300))
until gh release view "$tag" >/dev/null 2>&1; do
  if [ "$SECONDS" -ge "$deadline" ]; then
    echo "等了 5 分钟还没看到 Release $tag。" >&2
    echo "要么发版流程没走完，要么 tag 写错了。" >&2
    exit 1
  fi
  echo "  Release $tag 还没建好，10 秒后再看…"
  sleep 10
done

# 展开 glob。**没有匹配时必须明确报错**——静默地「上传了 0 个文件然后成功退出」
# 是最糟的结果：CI 一片绿，而 Release 上什么都没有。
#
# 这里**故意不加引号**：`assets=("$pattern")` 的话 bash 不做路径展开，数组里会是
# 那个模式字符串本身，于是下面的「一个都没匹配到」永远不触发，最后 `gh` 拿到模式
# 自己去找——找不到就报它自己的错。模式里不会有空格，所以不需要管分词。
#
# `shopt` + 不带引号的赋值在 bash 3.2（macOS 自带的那版）上也是这个行为，
# 而 CI 的 macOS 那一栏用的就是它。
shopt -s nullglob
assets=( $pattern )
shopt -u nullglob
if [ "${#assets[@]}" -eq 0 ]; then
  echo "没有文件匹配 $pattern。先确认打包那一步真的产出了东西。" >&2
  exit 1
fi

for asset in "${assets[@]}"; do
  echo "上传 $asset → $tag"
  # --clobber：重跑时覆盖同名资产（补资产、重试都会遇到）
  gh release upload "$tag" "$asset" --clobber
done

echo "完成。$tag 当前的资产："
gh release view "$tag" --json assets --jq '.assets[] | "  \(.name)  \(.size) 字节"'
