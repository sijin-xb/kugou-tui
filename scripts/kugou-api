#!/usr/bin/env bash
#
# kugou-api —— KuGouMusicApi 服务的启停管理（start / stop / restart / status / logs）。
#
# 网易云实例（netease）由启动器 kugou-tui 自己拉起，这里不负责 start 它；但
# stop / status / logs 认得它，所以启动器拉起的网易云也停得掉、看得到。
#
# 为什么需要两个实例：酷狗的两个平台是两套独立的鉴权体系，平台由服务端 `platform`
# 环境变量决定（`lite` = 概念版），而一个 Node 进程只能加载一份配置。所以要同时
# 用两个音源，就得起两个进程、各占一个端口。
#
# 注意：两个平台的登录态不通用。切到概念版音源后需要按 L 重新扫码。
#
# 用法：
#   ./scripts/kugou-api start     # 启动两个实例（已在跑的跳过）
#   ./scripts/kugou-api stop      # 停止（按 PID 精确停止，不是按名字模糊杀）
#   ./scripts/kugou-api restart   # 先停再起
#   ./scripts/kugou-api status    # 查看运行状态、PID、日志路径
#   ./scripts/kugou-api logs      # 跟随日志（默认 standard，可跟 lite / netease）
#   ./scripts/kugou-api help      # 打印这份说明
#
# 首次使用给执行权限：
#   chmod +x scripts/kugou-api
#   # 想全局可用就软链到 PATH 里，脚本自己会解软链找到仓库根目录：
#   ln -s "$(pwd)/scripts/kugou-api" ~/.local/bin/kugou-api
#
# 参数怎么给（优先级：**环境变量 > 配置文件 > 内置默认值**）：
#
#   KUGOU_API_DIR        KuGouMusicApi 的目录        默认 /usr/share/kugou-tui/api/kugou
#                                                     （软件包提供的只读副本，自带依赖），
#                                                     没有则退回 ~/KuGouMusicApi
#   KUGOU_API_LOG_DIR    日志与 PID 文件目录          默认 <缓存根>/kugou-tui
#                                                     Linux: ~/.cache/kugou-tui
#                                                     macOS: ~/Library/Caches/kugou-tui
#   KUGOU_API_HOST       监听地址                    默认 127.0.0.1
#   KUGOU_STANDARD_PORT  标准版端口                  默认 3000
#   KUGOU_LITE_PORT      概念版端口                  默认 3001
#   NETEASE_PORT         网易云实例端口（stop/status 找不到 PID 文件时的兜底）默认 3002
#   KUGOU_API_BIN        客户端二进制路径             默认 <仓库>/target/release/kugou-tui，
#                                                     不存在则用 PATH 上的 kugou-tui
#   KUGOU_API_SKIP_BUILD 设为 1 时跳过编译预检        默认空（会检查并在缺失时编译）
#
# 配置文件（可选）：`<配置根>/kugou-tui/api.env`，每行一个 `KEY=VALUE`，键名就是
# 上面那些环境变量名。文件里出现未知键会警告并忽略——不加限制地 source 一个用户
# 文件，等于允许它改写脚本里的任何变量（包括二进制路径），那是没必要的风险。
#
# 例：临时换个端口起一次，不改任何文件
#   KUGOU_STANDARD_PORT=3100 ./scripts/kugou-api restart
#
# 平台：Linux 与 macOS 共用这一份（Windows 侧是 scripts/kugou-api.ps1）。
#
set -euo pipefail

# ==================================================================
# 可移植性：下面每一处写法都是刻意的
#
#   readlink -f   GNU 扩展。macOS 的 readlink 直接报 `illegal option -- f`
#   dirname --    GNU 扩展，BSD 会把 `--` 当成参数本身
#   seq           GNU coreutils，BSD 环境用 jot
#   ss            iproute2，macOS 用 lsof
#   setsid        util-linux，macOS 没有
#   declare -A    需要 bash 4；macOS 自带的 /bin/bash 是 3.2
#
# 仓库里的三个 bash 脚本各自独立分发（AUR 装进 /usr/bin、发行包放进 scripts/、
# 也有人单独软链到 ~/.local/bin），所以**不做成共享库**：任何一份都得能单独跑起来。
# 代价是这段在每个脚本里重复一遍，改的时候三处一起改。
# ==================================================================

is_macos() { [ "$(uname -s 2>/dev/null)" = "Darwin" ]; }

# 脚本自身的真实目录，逐层解开软链（不用 `readlink -f`，理由见上）。
self_dir() {
  local target="$1" link
  while [ -L "$target" ]; do
    link=$(readlink "$target") || break
    case "$link" in
      /*) target="$link" ;;
      *) target="$(dirname "$target")/$link" ;;
    esac
  done
  cd -P "$(dirname "$target")" && pwd
}

# 配置根目录 / 缓存根目录。**必须与 Rust 侧 `dirs` crate 给出的一致**：
#
#   Linux : config=$XDG_CONFIG_HOME|~/.config   cache=$XDG_CACHE_HOME|~/.cache
#   macOS : config=~/Library/Application Support   cache=~/Library/Caches
#           （macOS 上 `dirs` 不读 XDG_* 变量，所以这里也不能读）
#   Windows: %APPDATA% / %LOCALAPPDATA%（由 PowerShell 脚本负责）
config_root() {
  if [ -n "${KUGOU_TUI_CONFIG_DIR:-}" ]; then
    printf '%s' "$KUGOU_TUI_CONFIG_DIR"
  elif is_macos; then
    printf '%s/Library/Application Support' "$HOME"
  else
    printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}"
  fi
}

cache_root() {
  if is_macos; then
    printf '%s/Library/Caches' "$HOME"
  else
    printf '%s' "${XDG_CACHE_HOME:-$HOME/.cache}"
  fi
}

# ==================================================================
# 参数解析
# ==================================================================

CONFIG_FILE="${KUGOU_API_CONFIG:-$(config_root)/kugou-tui/api.env}"

# 配置文件里只认这些键，多出来的一律警告并忽略（理由见文件头）。
#
# 用一组普通变量 + `pick` 里的间接展开，而不是 `declare -A`：关联数组要 bash 4，
# 而 macOS 自带的 /bin/bash 是 3.2。多写几行换来「在 macOS 上开箱能跑」。
CFG_KUGOU_API_DIR=""
CFG_KUGOU_API_LOG_DIR=""
CFG_KUGOU_API_HOST=""
CFG_KUGOU_STANDARD_PORT=""
CFG_KUGOU_LITE_PORT=""
CFG_NETEASE_PORT=""
CFG_KUGOU_API_BIN=""
CFG_KUGOU_API_SKIP_BUILD=""

load_config() {
  [ -r "$CONFIG_FILE" ] || return 0
  local key value
  while IFS='=' read -r key value || [ -n "$key" ]; do
    # 跳过空行与注释
    case "$key" in
      '' | \#*) continue ;;
    esac
    # 去掉首尾空白，再剥掉一层引号
    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    value="${value%"${value##*[![:space:]]}"}"
    value="${value#\"}"
    value="${value%\"}"
    value="${value#\'}"
    value="${value%\'}"
    # CFG_* 只被 `pick` 以间接展开 `${!cfg_name}` 读取，shellcheck 静态分析看不到，
    # 会对下面每个赋值误报 SC2034，这里显式豁免（整段 case 一起）。
    # shellcheck disable=SC2034
    case "$key" in
      KUGOU_API_DIR) CFG_KUGOU_API_DIR="$value" ;;
      KUGOU_API_LOG_DIR) CFG_KUGOU_API_LOG_DIR="$value" ;;
      KUGOU_API_HOST) CFG_KUGOU_API_HOST="$value" ;;
      KUGOU_STANDARD_PORT) CFG_KUGOU_STANDARD_PORT="$value" ;;
      KUGOU_LITE_PORT) CFG_KUGOU_LITE_PORT="$value" ;;
      NETEASE_PORT) CFG_NETEASE_PORT="$value" ;;
      KUGOU_API_BIN) CFG_KUGOU_API_BIN="$value" ;;
      KUGOU_API_SKIP_BUILD) CFG_KUGOU_API_SKIP_BUILD="$value" ;;
      *)
        printf '\033[33m配置 %s 里有未知键「%s」，已忽略\033[0m\n' \
          "$CONFIG_FILE" "$key" >&2
        ;;
    esac
  done <"$CONFIG_FILE"
}
load_config

# 取值：环境变量 > 配置文件 > 默认值。配置值按 `CFG_<变量名>` 找。
pick() {
  local env_name="$1" default="$2" value cfg_name cfg_value
  value="${!env_name:-}"
  if [ -n "$value" ]; then
    printf '%s' "$value"
    return
  fi
  cfg_name="CFG_$env_name"
  cfg_value="${!cfg_name:-}"
  if [ -n "$cfg_value" ]; then
    printf '%s' "$cfg_value"
    return
  fi
  printf '%s' "$default"
}

self_dir_path=$(self_dir "${BASH_SOURCE[0]}")
repo_dir=$(dirname "$self_dir_path")

# 客户端二进制在哪。
#
# 先看仓库里的构建产物（从源码跑时走这条），找不到再退回 PATH——脚本被**装到**
# `/usr/bin`（而不是软链过去）时，`$repo_dir/target/release` 会是 `/usr/target/...`，
# 必然不存在。发行版打包走的就是这条路。
default_client_bin() {
  local from_repo="$repo_dir/target/release/kugou-tui"
  if [ -x "$from_repo" ]; then
    printf '%s' "$from_repo"
    return
  fi
  # 都找不到时回落到仓库路径：报错信息里那条路径至少能提示「你该先编译」
  command -v kugou-tui 2>/dev/null || printf '%s' "$from_repo"
}

# 软件包把接口服务装在 `/usr/share/kugou-tui/api/<音源>`，**依赖随包安装**。
# 有这份就用它——那才是「装完即用」；没有才退回 ~ 下自己 clone 的那份。
#
# 实测这个服务**不往自己目录写任何文件**（源码里没有 writeFile / mkdirSync），
# 所以从只读目录跑没有问题。这也是它能被打包进 /usr 的前提。
SYSTEM_API_ROOT="${KUGOU_API_SYSTEM_ROOT:-/usr/share/kugou-tui/api}"

default_api_dir() {
  if [ -f "$SYSTEM_API_ROOT/kugou/app.js" ]; then
    printf '%s' "$SYSTEM_API_ROOT/kugou"
  else
    printf '%s' "$HOME/KuGouMusicApi"
  fi
}

is_system_api_dir() {
  case "$API_DIR" in
    "$SYSTEM_API_ROOT"/*) return 0 ;;
  esac
  return 1
}

API_DIR="$(pick KUGOU_API_DIR "$(default_api_dir)")"
LOG_DIR="$(pick KUGOU_API_LOG_DIR "$(cache_root)/kugou-tui")"
HOST="$(pick KUGOU_API_HOST 127.0.0.1)"
STANDARD_PORT="$(pick KUGOU_STANDARD_PORT 3000)"
LITE_PORT="$(pick KUGOU_LITE_PORT 3001)"
NETEASE_PORT="$(pick NETEASE_PORT 3002)"
BIN="$(pick KUGOU_API_BIN "$(default_client_bin)")"
SKIP_BUILD="$(pick KUGOU_API_SKIP_BUILD "")"

# 两个酷狗实例：名字 / 端口 / platform（标准版不传 platform，服务端默认就是手机版）
INSTANCES="standard:$STANDARD_PORT: lite:$LITE_PORT:--platform=lite"

# 网易云不是酷狗实例，由启动器 `kugou-tui` 自己拉起（目录、平台都和酷狗不是一套），
# 所以 kugou-api 不负责 start 它。但 stop / status / logs 必须认得它：它和酷狗写
# 同一套 PID 文件，认不得就只能放任它占着端口（以前更糟——它沿用 standard 实例名，
# `stop` 会照着 api-standard.pid 误杀到酷狗标准版）。
EXTERNAL_INSTANCES="netease:$NETEASE_PORT"

# ==================================================================
# 小工具
# ==================================================================

# 探活走 `/`：express.static 直接吐静态页，是纯本地操作。
# /register/dev 会真的请求酷狗服务器，冷缓存时要 1 秒以上。
alive() { curl -sf --max-time 2 -o /dev/null "http://$HOST:$1/" 2>/dev/null; }

# 监听该端口的进程 PID；没人监听就返回空。
#
# Linux 用 `ss`（iproute2），macOS 没有它——那边用 `lsof`。两条都留着：`ss` 的
# 输出更稳定，而 macOS 上只能靠 lsof。缺了这一步，macOS 上 `stop` 会在
# 「PID 文件丢了但端口还活着」时查不到 PID，只能放弃。
port_pid() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    # ss 的输出形如 `LISTEN 0 511 *:3001 *:* users:(("node",pid=101898,fd=21))`，
    # 所以先按端口筛行，再从 users 段里抠出 pid。
    ss -ltnp 2>/dev/null |
      grep -E "[:.]$port([[:space:]]|$)" |
      grep -oE 'pid=[0-9]+' | head -n 1 | cut -d= -f2
    return
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -n 1
  fi
}

pid_file() { printf '%s/api-%s.pid' "$LOG_DIR" "$1"; }
log_file() { printf '%s/api-%s.log' "$LOG_DIR" "$1"; }

# PID 文件里存「PID 端口」两个字段。
#
# 只存 PID 是不够的：改了端口重启（或只改配置没重启）时，旧进程还活着，
# 单看 `kill -0 $pid` 会通过，于是 status 拿**新**端口报一个「运行中」——
# 而那个进程其实监听在旧端口上。实测踩到过：配置文件把端口从 3001 改成 3101，
# status 却显示「:3101 运行中」，实际服务还在 3001 上。
pid_of() {
  local pid _port
  [ -s "$1" ] || return 0
  read -r pid _port <"$1" 2>/dev/null || true
  # PowerShell 5.1 的 Set-Content 写 PID 文件会带 UTF-8 BOM。BOM 只出现在文件开头，
  # 于是黏在第一个字段上，`kill -0 $pid` 拿到一个非法 PID，status/stop 全部失灵。
  pid="${pid#$'\xef\xbb\xbf'}"
  printf '%s' "${pid:-}"
}
port_of() {
  local _pid port
  [ -s "$1" ] || return 0
  read -r _pid port <"$1" 2>/dev/null || true
  # 端口是第二个字段，BOM 黏不到它；同样清一遍只是让两处口径一致。
  port="${port#$'\xef\xbb\xbf'}"
  printf '%s' "${port:-}"
}

# 外部实例（网易云）的端口不写死：它跟着当前音源的 api_base 走，启动器已经写进了
# PID 文件。读不到（还没起过、或文件已删）才退回配置里的默认端口。
external_port() {
  local name="$1" fallback="$2" port
  port="$(port_of "$(pid_file "$name")")"
  printf '%s' "${port:-$fallback}"
}

die() {
  printf '\033[31m%s\033[0m\n' "$1" >&2
  exit 1
}

# ==================================================================
# 启动前预检：缺什么就补什么，补不上就带着明确原因终止
# ==================================================================

require_node() {
  command -v node >/dev/null 2>&1 || die "找不到 node。先装 Node（>= 18），或把它放进 PATH。"
}

ensure_api_dir() {
  if [ ! -d "$API_DIR" ]; then
    printf '\033[31m找不到 KuGouMusicApi：%s\033[0m\n' "$API_DIR" >&2
    printf '用项目里的安装脚本拉一份（它会自动 clone + npm install）：\n' >&2
    printf '  %s/scripts/kugou-api-install kugou\n' "$repo_dir" >&2
    exit 1
  fi
}

# 依赖缺失就自动装——这就是这个服务现有的构建命令。
# 以前这里只打印一句「请先 npm install」，用户得自己复制粘贴；既然脚本已经
# 知道该怎么装，就该直接装。
ensure_deps() {
  if [ -d "$API_DIR/node_modules" ]; then
    return 0
  fi
  if [ ! -f "$API_DIR/package.json" ]; then
    die "「$API_DIR」里没有 package.json，看着不是 KuGouMusicApi。检查 KUGOU_API_DIR。"
  fi

  # 系统目录是只读的，依赖由软件包带。往 /usr 里写既装不进去、也不该做；
  # 缺了说明包本身有问题，让用户重装比在这里 npm install 更靠谱。
  if is_system_api_dir; then
    die "「$API_DIR」缺少 node_modules。这是软件包提供的位置，请重装：pacman -S kugou-tui"
  fi

  printf '\033[36m缺少依赖，正在安装（npm install --omit=dev）…\033[0m\n' >&2
  if ! (cd "$API_DIR" && npm install --omit=dev) >&2; then
    printf '\033[31m依赖安装失败\033[0m\n' >&2
    printf '手动重试：cd "%s" && npm install --omit=dev\n' "$API_DIR" >&2
    exit 1
  fi
}

# 客户端二进制缺失就自动编译。
#
# 放在这里是刻意的：一键启动要的是「整套能用」，只起服务、客户端没编译，
# 用户接着跑 ./scripts/kugou-tui 还是会撞上「找不到可执行文件」。
# 已经编译过时这一步只是一次 `-x` 判断，开销可忽略；不想编译就设
# KUGOU_API_SKIP_BUILD=1，或只对 stop / status 调用（这两个不触发编译）。
ensure_binary() {
  [ -n "$SKIP_BUILD" ] && return 0
  [ -x "$BIN" ] && return 0

  if ! command -v cargo >/dev/null 2>&1; then
    printf '\033[33m没有 cargo，跳过编译：%s\033[0m\n' "$BIN" >&2
    return 0
  fi

  printf '\033[36m客户端二进制不存在，正在编译（cargo build --release）…\033[0m\n' >&2
  if ! (cd "$repo_dir" && cargo build --release) >&2; then
    printf '\033[31m编译失败\033[0m\n' >&2
    printf '手动重试：cd "%s" && cargo build --release\n' "$repo_dir" >&2
    exit 1
  fi
  [ -x "$BIN" ] || die "编译后仍然找不到 $BIN，检查 KUGOU_API_BIN。"
}

# 日志目录必须存在且可写：写不进去的话服务会起不来，
# 而失败原因会藏在一句含糊的 nohup 报错里，很难查。
ensure_log_dir() {
  if ! mkdir -p "$LOG_DIR" 2>/dev/null; then
    die "创建日志目录失败：${LOG_DIR}（检查权限，或用 KUGOU_API_LOG_DIR 换一个位置）"
  fi
  if [ ! -w "$LOG_DIR" ]; then
    die "日志目录不可写：${LOG_DIR}（检查权限，或用 KUGOU_API_LOG_DIR 换一个位置）"
  fi
}

# ==================================================================
# 启停
# ==================================================================

start_one() {
  local name="$1" port="$2" platform_flag="$3"
  local pidf log running_pid recorded_port pid
  pidf="$(pid_file "$name")"
  log="$(log_file "$name")"
  running_pid="$(pid_of "$pidf")"
  recorded_port="$(port_of "$pidf")"

  # 已经是我们起的实例：读 PID 文件确认，不要重复拉第二个进程
  if [ -n "$running_pid" ] && kill -0 "$running_pid" 2>/dev/null; then
    if [ -n "$recorded_port" ] && [ "$recorded_port" != "$port" ]; then
      # 进程活着，但当初是给别的端口起的——多半是改了端口没重启。
      # 这时候既不能报「已在运行」（新端口上没有服务），也不能硬起第二个
      # （旧进程还占着它自己的端口，用户会以为配置没生效）。
      printf '\033[33m%s 的旧实例仍在运行（PID %s，端口 %s），但本次配置的端口是 %s\033[0m\n' \
        "$name" "$running_pid" "$recorded_port" "$port" >&2
      printf '  先停掉它再起：%s restart\n' "$0" >&2
      return 1
    fi
    printf '  \033[33m%s :%s 已在运行（PID %s），跳过\033[0m\n' \
      "$name" "$port" "$running_pid"
    return 0
  fi

  # 端口被别的进程占着：这是最容易看走眼的一种失败——
  # 不区分的话会当成「已在运行」，用户以为服务起了，实际监听的是别的东西。
  if alive "$port"; then
    local owner upper
    owner="$(port_pid "$port")"
    upper="$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')"
    printf '\033[31m端口 :%s 已被占用（PID %s），无法启动 %s\033[0m\n' \
      "$port" "${owner:-未知}" "$name" >&2
    printf '  换个端口起：KUGOU_%s_PORT=3100 %s start\n' "$upper" "$0" >&2
    printf '  或先停掉占用者：kill %s\n' "${owner:-<PID>}" >&2
    return 1
  fi

  # 两个都给（环境变量 + 命令行参数），因为 KuGouMusicApi 认 `--port=`。
  # 用 shell 内联赋值而不是 `env` 命令：后者在值为空时会直接报错。
  #
  # `exec` 是关键：它让子 shell 被 node 取代，这样 `$!` 拿到的就是 node 自己的
  # PID；否则 PID 文件里记的是子 shell / setsid 那一层，stop 时 kill 了也停不掉
  # 真正的服务。
  #
  # setsid 是 util-linux 专有的，macOS 没有。那边退回 nohup——仍在同一会话，
  # 但足以活过启动它的终端（差别只在终端关闭时的信号处理）。
  if command -v setsid >/dev/null 2>&1; then
    (
      cd "$API_DIR" &&
        exec setsid env PORT="$port" node app.js --port="$port" \
          ${platform_flag:+$platform_flag} >>"$log" 2>&1 </dev/null
    ) &
  else
    (
      cd "$API_DIR" &&
        exec nohup env PORT="$port" node app.js --port="$port" \
          ${platform_flag:+$platform_flag} >>"$log" 2>&1 </dev/null
    ) &
  fi
  pid=$!
  printf '%s %s' "$pid" "$port" >"$pidf"

  # 等就绪：40 × 0.5 秒。不用 `seq`（GNU coreutils，BSD 环境没有）。
  local attempt=0
  while [ "$attempt" -lt 40 ]; do
    sleep 0.5
    alive "$port" && break
    attempt=$((attempt + 1))
  done

  if ! alive "$port"; then
    printf '  \033[31m%s :%s 启动失败（PID %s）\033[0m\n' "$name" "$port" "$pid" >&2
    printf '    日志：%s\n' "$log" >&2
    tail -n 10 "$log" >&2 2>/dev/null || true
    rm -f "$pidf"
    return 1
  fi

  printf '  \033[32m%s :%s 已就绪\033[0m  PID %s\n' "$name" "$port" "$pid"
  printf '      地址 http://%s:%s/   日志 %s\n' "$HOST" "$port" "$log"
  return 0
}

stop_one() {
  local name="$1" port="$2"
  local pidf pid attempt=0
  pidf="$(pid_file "$name")"
  pid="$(pid_of "$pidf")"

  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    # 给一点时间退出；还在就升级到 -9
    while [ "$attempt" -lt 20 ]; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.25
      attempt=$((attempt + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true
      sleep 0.3
    fi
    printf '  %s 已停止（PID %s）\n' "$name" "$pid"
  elif alive "$port"; then
    # PID 文件丢了但端口还活着：按端口找回来，不要漏掉
    pid="$(port_pid "$port")"
    if [ -n "$pid" ]; then
      kill "$pid" 2>/dev/null || true
      printf '  %s :%s 已停止（PID %s，PID 文件缺失，按端口找回）\n' "$name" "$port" "$pid"
    else
      printf '  \033[33m%s :%s 端口有人在监听，但查不到 PID，未处理\033[0m\n' \
        "$name" "$port" >&2
    fi
  else
    printf '  %s :%s 未运行\n' "$name" "$port"
  fi
  rm -f "$pidf"
}

status_one() {
  local name="$1" port="$2"
  local pidf log pid recorded
  pidf="$(pid_file "$name")"
  log="$(log_file "$name")"
  pid="$(pid_of "$pidf")"
  recorded="$(port_of "$pidf")"

  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    if [ -n "$recorded" ] && [ "$recorded" != "$port" ]; then
      printf '  \033[33m●\033[0m %-8s :%-5s 旧实例仍在运行（PID %s，端口 %s）——配置的端口变了，需 restart\n' \
        "$name" "$port" "$pid" "$recorded"
      printf '           旧地址 http://%s:%s/\n' "$HOST" "$recorded"
    else
      printf '  \033[32m●\033[0m %-8s :%-5s 运行中  PID %s\n' "$name" "$port" "$pid"
      printf '           地址 http://%s:%s/\n' "$HOST" "$port"
      printf '           日志 %s\n' "$log"
    fi
  elif alive "$port"; then
    printf '  \033[33m●\033[0m %-8s :%-5s 端口有响应，但不是本脚本起的（PID %s）\n' \
      "$name" "$port" "$(port_pid "$port")"
    printf '           地址 http://%s:%s/\n' "$HOST" "$port"
  else
    printf '  \033[31m○\033[0m %-8s :%-5s 未运行\n' "$name" "$port"
    printf '           日志 %s\n' "$log"
  fi
}

# ==================================================================
# 命令分发
# ==================================================================

usage() {
  # 打印文件头的注释块（第 3 行起，到 `set -euo` 为止），并去掉行首的 "# "。
  # 不写死行号：以前是 `sed -n '3,40p'`，注释一长就被截在半句话上。
  awk 'NR >= 3 && /^set -euo/ { exit } NR >= 3 { sub(/^# ?/, ""); print }' \
    "${BASH_SOURCE[0]}"
}

case "${1:-start}" in
  start)
    require_node
    ensure_api_dir
    ensure_deps
    ensure_binary
    ensure_log_dir

    printf '启动 KuGouMusicApi（%s）\n' "$API_DIR"
    failed=0
    for entry in $INSTANCES; do
      name="${entry%%:*}"
      rest="${entry#*:}"
      port="${rest%%:*}"
      platform_flag="${rest#*:}"
      start_one "$name" "$port" "$platform_flag" || failed=1
    done
    printf '标准版 :%s ／ 概念版 :%s\n' "$STANDARD_PORT" "$LITE_PORT"
    printf '试一个：curl "%s/search?keywords=海阔天空&limit=1"\n' \
      "http://$HOST:$STANDARD_PORT"
    [ "$failed" -eq 0 ] || exit 1
    ;;

  stop)
    printf '停止 KuGouMusicApi\n'
    for entry in $INSTANCES; do
      name="${entry%%:*}"
      rest="${entry#*:}"
      stop_one "$name" "${rest%%:*}"
    done
    # 网易云由启动器拉起，但它和酷狗写同一套 PID 文件，stop 就该把它也停掉，
    # 而不是留着它继续占端口。
    for entry in $EXTERNAL_INSTANCES; do
      name="${entry%%:*}"
      stop_one "$name" "$(external_port "$name" "${entry#*:}")"
    done
    ;;

  restart)
    printf '重启 KuGouMusicApi\n'
    for entry in $INSTANCES; do
      name="${entry%%:*}"
      rest="${entry#*:}"
      stop_one "$name" "${rest%%:*}"
    done
    # 网易云不在重启范围内：restart 的语义是重启 KuGouMusicApi，而 kugou-api 不负责
    # 拉起网易云（那是启动器的事）。停掉它反而会留下一个没人再起的服务。
    # 端口释放需要一点时间，不等的话下一轮会把「还没退干净」误判成端口占用
    sleep 1
    exec "$0" start
    ;;

  status)
    printf 'KuGouMusicApi 状态\n'
    for entry in $INSTANCES; do
      name="${entry%%:*}"
      rest="${entry#*:}"
      status_one "$name" "${rest%%:*}"
    done
    for entry in $EXTERNAL_INSTANCES; do
      name="${entry%%:*}"
      status_one "$name" "$(external_port "$name" "${entry#*:}")"
    done
    ;;

  logs)
    # 跟着日志看服务在说什么。`kugou-api logs` 跟标准版，`logs lite` 跟概念版。
    # 服务起来之后最常见的两个问题（端口被占、平台没传对）在日志里一眼能看出来，
    # 而在此之前用户得自己去翻 status 打印的那条路径。
    instance="${2:-standard}"
    case "$instance" in
      standard | lite | netease) ;;
      *) die "未知实例：$instance（可用：standard / lite / netease）" ;;
    esac
    log="$(log_file "$instance")"
    [ -f "$log" ] || die "日志还不存在：$log（这个实例还没起过？先 kugou-api start）"
    printf '跟随 %s（Ctrl-C 退出）\n' "$log"
    tail -n 40 -f "$log"
    ;;

  help | -h | --help)
    usage
    ;;

  *)
    printf '未知命令：%s\n\n' "$1" >&2
    usage >&2
    exit 1
    ;;
esac
