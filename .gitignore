# 构建产物
/target

# Release 用的二进制包（scripts/make-release-tarball 产出）
/dist

# makepkg 的工作目录与产物（packaging/arch/）
/packaging/arch/src
/packaging/arch/pkg
/packaging/arch/*.pkg.tar.*
/packaging/arch/*.tar.gz
/packaging/arch/*.tar.xz
/packaging/arch/*.tar.zst

# 环境变量（可能含服务端配置）
.env
.env.local

# 编辑器与系统
.DS_Store
Thumbs.db
*.swp

# 日志
*.log

# Python 字节码（scripts/license-stats.py）
__pycache__/
*.pyc
